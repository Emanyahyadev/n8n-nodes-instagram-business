{
  "name": "n8n-nodes-instagram-api",
  "version": "0.2.4",
  "description": "Community node for n8n integrating Instagram Business Login & Meta Graph API with AI Agent tool support",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "instagram",
    "instagram-api",
    "instagram-login",
    "meta",
    "business-login",
    "ai-tool",
    "ai-agent"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/InstagramApi.credentials.js",
      "dist/credentials/InstagramOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Instagram/Instagram.node.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.45.4",
    "@types/node": "^20.17.19",
    "n8n-workflow": "^1.78.0",
    "typescript": "^5.7.3"
  }
}
